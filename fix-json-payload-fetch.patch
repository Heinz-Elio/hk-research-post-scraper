diff --git a/scraper.py b/scraper.py
--- a/scraper.py
+++ b/scraper.py
@@
 def save_json(path: Path, data: Dict[str, dict]):
     items = sorted(
         data.values(),
         key=lambda x: (x.get("close_date") or "9999-12-31", x.get("title") or ""),
         reverse=True,
     )
     with open(path, "w", encoding="utf-8") as f:
         json.dump(items, f, ensure_ascii=False, indent=2)


+def save_public_json(data: Dict[str, dict]):
+    """Write a compact frontend payload without embeddings or full-text data."""
+    public_file = DATA_DIR / "docs" / "research_posts.json"
+    public_file.parent.mkdir(parents=True, exist_ok=True)
+
+    public_fields = (
+        "id", "title", "close_date", "summary", "work_type",
+        "degree_level", "department", "url", "source", "scraped_at",
+    )
+    items = sorted(
+        ({key: post[key] for key in public_fields if key in post}
+         for post in data.values()),
+        key=lambda x: (x.get("close_date") or "9999-12-31", x.get("title") or ""),
+        reverse=True,
+    )
+    with open(public_file, "w", encoding="utf-8") as f:
+        json.dump(items, f, ensure_ascii=False, separators=(",", ":"))
+        f.write("\\n")
+
+
 # ==================================================================
 # Main logic
 # ==================================================================
@@
     save_json(ACTIVE_FILE, active)
     save_json(OUTDATED_FILE, outdated)
+    save_public_json(active)

     print("\\n" + "=" * 50)
